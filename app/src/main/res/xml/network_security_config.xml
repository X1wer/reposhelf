<!-- Csak HTTPS, csak rendszer-CA-k (felhasználói CA nélkül), tanúsítvány-pinning nélkül (D-052). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
