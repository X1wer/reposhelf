<!--
  SPDX-FileCopyrightText: 2026 RepoShelf contributors
  SPDX-License-Identifier: GPL-3.0-or-later

  Jogosultságok: a 2. munkamenetben csak INTERNET. A telepítéshez és a háttérműködéshez szükséges
  jogosultságok a 3–5. munkamenetben kerülnek ide, indoklással (docs/ARCHITECTURE.md 11–13.).
  Exportált komponens csak a launcher-activity (docs/ARCHITECTURE.md 10.1.).

  Mentés (biztonsági audit, STO-01): az alkalmazás adatai sem felhőmentésbe, sem eszközök közötti átvitelbe nem
  kerülnek (allowBackup=false és mindent kizáró szabályok). Az adatok eszközhöz kötött bizalmi állapotot is tartalmaznak
  (rögzített aláírók, repó-azonosítók, függő telepítések), amelyek más eszközön érvénytelenek vagy félrevezetők
  lennének. A követett lista átvitelére az export/import szolgál (C. 25.).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Értesítések (Android 13+ futásidejű engedély): nem első indításkor kérjük, hanem az első követéskor vagy az
         értesítések bekapcsolásakor, magyarázattal (ARCH 12., D-063). A WorkManager a hálózat- és az újraindítás-
         figyeléshez saját engedélyeket hoz (ACCESS_NETWORK_STATE, RECEIVE_BOOT_COMPLETED, WAKE_LOCK). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Normál engedély (Android 12+): amíg az app előtérben van, a nem rendszer-átfedések nem látszanak, így a biztonsági
         döntések gombjai nem takarhatók el megtévesztő felülettel (tapjacking; MainActivity). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <application
        android:name=".RepoShelfApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.RepoShelf">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A saját frissítés eredményének rögzítése a csomagcsere után (C. 14.; docs/ARCHITECTURE.md 14.). -->
        <receiver
            android:name=".selfupdate.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
