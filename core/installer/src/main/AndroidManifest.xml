<!--
  SPDX-FileCopyrightText: 2026 RepoShelf contributors
  SPDX-License-Identifier: GPL-3.0-or-later

  A telepítéshez szükséges jogosultságok, indoklással (C. 7.3.: nincs rejtett vagy indokolatlan jogosultság):
  - REQUEST_INSTALL_PACKAGES: a PackageInstaller-session használata. A felhasználónak az „ismeretlen forrásból
    származó alkalmazások telepítése” engedélyt külön meg kell adnia (Android 8+, alkalmazásonként).
  - ENFORCE_UPDATE_OWNERSHIP (normál, Android 14+): első telepítéskor kérhetjük, hogy más telepítő csak a
    felhasználó jóváhagyásával frissíthesse az appot (D-043).
  - REQUEST_DELETE_PACKAGES (normál): az „Alkalmazásaim” képernyőről kezdeményezett eltávolítás (C. 10.). Csak a
    rendszer megerősítő ablakát nyitja meg; a felhasználó dönt, a háttérben semmi nem törlődik.
  Package visibility (végleges döntés, D-040): a MAIN/LAUNCHER query QUERY_ALL_PACKAGES nélkül teszi láthatóvá az
  indítható appokat, így kiolvasható a telepített verzió és az aláíró. A telepítő NEM látja automatikusan a saját
  telepítéseit. Az indítóikon nélküli csomagok nem láthatók: a felület ezt jelzi („nem telepített vagy nem látható”).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Normál engedély (Android 12+): a felhasználói beavatkozás nélküli FRISSÍTÉS feltétele (ARCH 11.2.). Csak akkor
         használjuk, ha a felhasználó bekapcsolta az automatikus telepítést, és minden feltétel teljesül. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!-- Csak a PackageInstaller küld ide (explicit, mutábilis PendingIntent-tel); kívülről nem érhető el. -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
